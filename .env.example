# Optional OpenAI-compatible endpoint. When all three are set, the app calls
# {LLM_BASE_URL}/chat/completions with the supplied bearer key and model.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible aliases. OPENAI_BASE_URL is optional for the official API;
# set it when using OpenRouter, Ollama, vLLM, OneAPI, or another compatible server.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Anthropic Messages provider (used when no OpenAI-compatible values exist).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional persistent embedded PostgreSQL directory.
AI_HANDOFF_DATA_DIR=.data/postgres

# Optional read-only OneDev pull request integration. The token stays on the server.
ONEDEV_SERVER_URL=
ONEDEV_ACCESS_TOKEN=
ONEDEV_PROJECT_PATH=
# Optional bare cache for PR refs; the registered checkout is never changed.
AI_HANDOFF_GIT_CACHE_DIR=.data/git-cache
