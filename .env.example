# Optional: choose one provider. Without these values the app uses a local, non-generative summary.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional persistent embedded PostgreSQL directory.
AI_HANDOFF_DATA_DIR=.data/postgres

# Optional read-only OneDev pull request integration. The token stays on the server.
ONEDEV_SERVER_URL=
ONEDEV_ACCESS_TOKEN=
ONEDEV_PROJECT_PATH=
# Optional bare cache for PR refs; the registered checkout is never changed.
AI_HANDOFF_GIT_CACHE_DIR=.data/git-cache
